// Tonearm compositor shaders. Mirrors src/core/compositor_cpu.cpp.
// All textures are premultiplied BGRA; output is premultiplied.

uniform float4x4 ViewProj;
uniform texture2d image;

// Layer
uniform float opacity;
uniform float4 dst_rect;   // x, y, w, h of the quad in source pixels
uniform float4 clip_rect;  // x0, y0, x1, y1 in source pixels
uniform float2 fade;       // soft edge widths (left, right) in pixels
uniform float use_clip;

// Rounded rectangle
uniform float4 color;      // premultiplied
uniform float2 rect_size;  // size of the drawn quad in pixels
uniform float2 half_size;  // half extents of the shape
uniform float radius;
uniform float softness;

// Video (animated artwork). The texture is already cropped to the artwork box.
uniform float v_radius;      // artwork corner radius
uniform float4 v_clip;       // card rect: x0, y0, x1, y1
uniform float v_clip_radius;
uniform float2 v_feather;    // edge (0 none, 1 right, 2 bottom), width in px
uniform float video_needs_srgb_encode; // 1: linear 16-bit source; 0: already sRGB 8-bit source

sampler_state linear_clamp {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

float4 PSLayer(VertData v_in) : TARGET
{
	float4 c = image.Sample(linear_clamp, v_in.uv) * opacity;
	if (use_clip > 0.5) {
		float2 p = dst_rect.xy + v_in.uv * dst_rect.zw;
		float m = step(clip_rect.x, p.x) * step(p.x, clip_rect.z) * step(clip_rect.y, p.y) * step(p.y, clip_rect.w);
		if (fade.x > 0.0)
			m *= saturate((p.x - clip_rect.x) / fade.x);
		if (fade.y > 0.0)
			m *= saturate((clip_rect.z - p.x) / fade.y);
		c *= m;
	}
	return c;
}

float sd_round_rect(float2 p, float2 h, float r)
{
	float2 q = abs(p) - h + float2(r, r);
	return length(max(q, float2(0.0, 0.0))) + min(max(q.x, q.y), 0.0) - r;
}

float4 PSRoundRect(VertData v_in) : TARGET
{
	float2 p = v_in.uv * rect_size - rect_size * 0.5;
	float d = sd_round_rect(p, half_size, radius);
	float a;
	if (softness > 0.0) {
		// Soft falloff approximating a blurred shape (used for glows).
		float t = saturate((d + softness * 0.5) / (softness * 1.5));
		a = 1.0 - t;
		a = a * a * (3.0 - 2.0 * a);
	} else {
		a = saturate(0.5 - d);
	}
	return color * a;
}

float coverage_round_rect(float2 p, float2 center, float2 h, float r)
{
	float rr = min(r, min(h.x, h.y));
	return saturate(0.5 - sd_round_rect(p - center, h, rr));
}

// OBS FFmpeg's 8-bit SDR (e.g. NV12/H.264) path already delivers sRGB
// encoded RGB; 10-bit/16-bit linear render paths may require transfer encoding
// when Tonearm composites into the sRGB authored layers with framebuffer sRGB off.
// Never apply this transfer unconditionally: it double-encodes 8-bit artwork
// and washes out colors, especially in Smart (H.264) video mode.
float3 VideoLinearToSrgb(float3 linearValue)
{
	float3 x = saturate(linearValue);
	float3 low = 12.92 * x;
	// pow() of exactly 0 is undefined in HLSL and can produce NaN on some drivers;
	// lerp() would carry that NaN into black pixels even though `low` is selected
	// there. The floor only affects values below the 0.0031308 threshold.
	float3 high = 1.055 * pow(max(x, float3(1e-6, 1e-6, 1e-6)), float3(1.0 / 2.4, 1.0 / 2.4, 1.0 / 2.4)) - 0.055;
	return lerp(low, high, step(float3(0.0031308, 0.0031308, 0.0031308), x));
}

// Mirrors videoCoverage() in src/core/compositor_cpu.cpp.
float4 PSVideo(VertData v_in) : TARGET
{
	float2 p = dst_rect.xy + v_in.uv * dst_rect.zw;
	float a = coverage_round_rect(p, dst_rect.xy + dst_rect.zw * 0.5, dst_rect.zw * 0.5, v_radius);
	float2 c0 = v_clip.xy, c1 = v_clip.zw;
	if (c1.x > c0.x && c1.y > c0.y)
		a *= coverage_round_rect(p, (c0 + c1) * 0.5, (c1 - c0) * 0.5, v_clip_radius);
	if (v_feather.x > 0.5 && v_feather.y > 0.0) {
		float d = v_feather.x < 1.5 ? (dst_rect.x + dst_rect.z - p.x) : (dst_rect.y + dst_rect.w - p.y);
		float t = saturate(d / v_feather.y);
		a *= t * t * (3.0 - 2.0 * t);
	}
	float4 c = image.Sample(linear_clamp, v_in.uv);
	// The video source's actual OBS color space decides whether encoding is
	// needed. 8-bit sRGB video must stay untouched; high-precision linear
	// video is encoded exactly once for this sRGB compositor.
	c.rgb = lerp(c.rgb, VideoLinearToSrgb(c.rgb), video_needs_srgb_encode);
	c.rgb = lerp(c.rgb, color.rgb, color.a); // paused dim: tint toward the card tone
	c.rgb *= c.a; // video frames are straight alpha (normally opaque)
	return c * (a * opacity);
}

technique Video
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSVideo(v_in);
	}
}

technique Layer
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSLayer(v_in);
	}
}

technique RoundRect
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSRoundRect(v_in);
	}
}
